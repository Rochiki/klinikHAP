# Salin berkas ini menjadi server/.env lalu isi sesuai server email perusahaan.
# Berkas .env TIDAK ikut ke GitHub (sudah ada di .gitignore). Jangan pernah meng-commit kata sandi.

PORT=3000
# 127.0.0.1 = hanya bisa dibuka dari laptop ini (disarankan).
HOST=127.0.0.1

# --- SMTP (contoh Microsoft 365 / Office 365) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# true hanya untuk port 465; port 587 memakai STARTTLS otomatis
SMTP_SECURE=false
SMTP_USER=klinik@perusahaan.co.id
SMTP_PASS=
# Pengirim yang tampil di email. Kosong = memakai SMTP_USER.
MAIL_FROM="Klinik HAP <klinik@perusahaan.co.id>"

# Opsional: batasi domain penerima (pisahkan koma). Kosong = semua domain diizinkan.
# ALLOWED_DOMAINS=perusahaan.co.id

# Opsional: mode uji. Tanpa SMTP_HOST, email hanya dicatat di terminal (tidak dikirim).
# MAIL_DRY_RUN=1
